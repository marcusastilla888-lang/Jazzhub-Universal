-- Self-contained Fly Controller
local Fly = {
	Enabled = false,
	Speed = 60,
	Connection = nil,
	LinearVelocity = nil,
	AlignOrientation = nil,
	Attachment = nil,
}

local function cleanupFlyForces()
	if Fly.Connection then
		Fly.Connection:Disconnect()
		Fly.Connection = nil
	end
	if Fly.LinearVelocity then
		Fly.LinearVelocity:Destroy()
		Fly.LinearVelocity = nil
	end
	if Fly.AlignOrientation then
		Fly.AlignOrientation:Destroy()
		Fly.AlignOrientation = nil
	end
	if Fly.Attachment then
		Fly.Attachment:Destroy()
		Fly.Attachment = nil
	end
end

function Fly.SetEnabled(state: boolean)
	Fly.Enabled = state
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")

	cleanupFlyForces()

	if not state then
		if humanoid then
			humanoid.PlatformStand = false
		end
		return
	end

	if not character or not humanoid or not rootPart then
		Fly.Enabled = false
		return
	end

	humanoid.PlatformStand = true

	local attachment = Instance.new("Attachment")
	attachment.Name = "JazzFlyAttachment"
	attachment.Parent = rootPart

	local lv = Instance.new("LinearVelocity")
	lv.Name = "JazzFlyVelocity"
	lv.Attachment0 = attachment
	lv.MaxForce = math.huge
	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	lv.VectorVelocity = Vector3.zero
	lv.Parent = rootPart

	local ao = Instance.new("AlignOrientation")
	ao.Name = "JazzFlyOrientation"
	ao.Attachment0 = attachment
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.MaxTorque = math.huge
	ao.Responsiveness = 25
	ao.CFrame = rootPart.CFrame
	ao.Parent = rootPart

	Fly.Attachment = attachment
	Fly.LinearVelocity = lv
	Fly.AlignOrientation = ao

	Fly.Connection = RunService.RenderStepped:Connect(function()
		if not Fly.Enabled then
			return
		end

		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local camera = workspace.CurrentCamera

		if not char or not hum or not hrp or not camera then
			Fly.SetEnabled(false)
			return
		end

		hum.PlatformStand = true
		local moveDir = hum.MoveDirection
		local flyVelocity = Vector3.zero

		if moveDir.Magnitude > 0 then
			-- Project movement onto camera look/right vectors for 3D flight
			local forward = camera.CFrame.LookVector
			local right = camera.CFrame.RightVector
			local relativeForward = hrp.CFrame.LookVector:Dot(moveDir)
			local relativeRight = hrp.CFrame.RightVector:Dot(moveDir)

			local wishDir = (forward * relativeForward + right * relativeRight)
			if wishDir.Magnitude > 0 then
				flyVelocity = wishDir.Unit * Fly.Speed
			end
		end

		lv.VectorVelocity = flyVelocity
		ao.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + camera.CFrame.LookVector)
	end)
end

function Fly.Toggle()
	Fly.SetEnabled(not Fly.Enabled)
	return Fly.Enabled
end

function Fly.SetSpeed(newSpeed: number)
	Fly.Speed = math.clamp(tonumber(newSpeed) or Fly.Speed, 1, 500)
	return Fly.Speed
end

-- Reset flight cleanly on respawn
LocalPlayer.CharacterAdded:Connect(function()
	Fly.SetEnabled(false)
end)

